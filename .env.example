# ============================================================================
# HomeServe Technologies — Root Environment Reference (.env.example)
# See also: backend/.env.example and frontend/.env.example
# ============================================================================

# --- Backend FastAPI Configuration ---
APP_NAME="HomeServe Technologies SaaS API"
ENVIRONMENT="development"
DEBUG=False
API_V1_PREFIX="/api/v1"
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/homeserve_saas"
JWT_SECRET_KEY="replace-with-strong-64-char-production-jwt-secret-key"
JWT_REFRESH_SECRET_KEY="replace-with-strong-64-char-production-refresh-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
DEFAULT_PLATFORM_COMMISSION_PERCENT=15.0
DEFAULT_TAX_PERCENT=18.0
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="rzp_test_your_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_your_webhook_secret"
STORAGE_PROVIDER="local"
MAX_UPLOAD_SIZE_MB=5

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_NAME="HomeServe Technologies"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

