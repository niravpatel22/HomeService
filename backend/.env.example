# Application Settings
APP_NAME="HomeServe Technologies SaaS API"
ENVIRONMENT="development"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Server & CORS
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# MySQL Database Connection (Production / Cloud MySQL)
# Example MySQL: mysql+pymysql://homeserve_user:homeserve_pass@localhost:3306/homeserve_db
DATABASE_URL="sqlite:///./homeserve.db"

# JWT & Security
JWT_SECRET_KEY="CHANGE_THIS_TO_A_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY_HOMESERVE"
JWT_REFRESH_SECRET_KEY="CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_SECRET_KEY_HOMESERVE"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Platform Business Configuration
DEFAULT_PLATFORM_COMMISSION_PERCENT=15.0
DEFAULT_TAX_PERCENT=18.0

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_homeserve_key_id"
RAZORPAY_KEY_SECRET="rzp_test_homeserve_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_homeserve_webhook_secret"

# Cloudinary / File Storage Configuration
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_UPLOAD_SIZE_MB=5

