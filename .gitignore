# ============================================================================
# HomeServe Technologies — Home Services Booking SaaS Platform (.gitignore)
# ============================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node / Frontend Dependencies & Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
backend/.venv/
backend/venv/
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Local SQLite Databases & Runtime Uploads
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/uploads/
uploads/

# Playwright & E2E Artifacts
frontend/playwright-report/
frontend/test-results/
playwright-report/
test-results/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

